# Production template. Fill values on the production host; never commit .env.
ENVIRONMENT=production
DEBUG=false
DEVELOPMENT_MODE=false
TELEGRAM_BOT_TOKEN=replace-on-production-host
TELEGRAM_BOT_USERNAME=replace-on-production-host
APPROVED_DIRECTORY=/srv/assist-ai
ALLOWED_USERS=123456789
DATABASE_URL=sqlite:////var/lib/assist-ai/data/bot.db
USE_SDK=true
ANTHROPIC_API_KEY=
ENABLE_API_SERVER=false
ENABLE_SCHEDULER=false
LOG_LEVEL=INFO
