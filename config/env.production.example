# Production template for mybots. Fill values on the host; never copy them into Git.
ENVIRONMENT=production
DEBUG=false
DEVELOPMENT_MODE=false
TELEGRAM_BOT_TOKEN=replace-on-host
TELEGRAM_BOT_USERNAME=replace-on-host
APPROVED_DIRECTORY=/home/mzored/projects
ALLOWED_USERS=123456789
DATABASE_URL=sqlite:////home/mzored/projects/assist-ai/bot/data/bot.db
USE_SDK=true
ANTHROPIC_API_KEY=
ENABLE_API_SERVER=false
ENABLE_SCHEDULER=false
LOG_LEVEL=INFO
