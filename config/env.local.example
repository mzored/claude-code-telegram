# Local macOS development only. Replace placeholders; never commit .env.
ENVIRONMENT=development
DEBUG=true
DEVELOPMENT_MODE=true
TELEGRAM_BOT_TOKEN=replace-with-development-token
TELEGRAM_BOT_USERNAME=replace-with-development-bot-name
APPROVED_DIRECTORY=/Users/your-user/Code
ALLOWED_USERS=123456789
DATABASE_URL=sqlite:///data/bot.db
USE_SDK=true
ANTHROPIC_API_KEY=
ENABLE_API_SERVER=false
ENABLE_SCHEDULER=false
LOG_LEVEL=DEBUG
